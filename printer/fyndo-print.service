[Unit]
Description=Fyndo Bon-Druckserver (Bondrucker)
After=network.target

[Service]
Type=simple
# Pfad zum printer/-Ordner anpassen:
WorkingDirectory=%h/Dokumente/code/fyndo/printer
Environment=PORT=8787
Environment=HOST=0.0.0.0
Environment=PRINTER_NAME=Bondrucker
Environment=PRINTER_MODE=cups
Environment=PRINTER_WIDTH=32
Environment=CHARSET=ascii
Environment=CUT_MODE=partial
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
